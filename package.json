{
  "name": "dsh-better-sidebar-svn",
  "version": "0.3.1",
  "description": "DSH better-sidebar 插件：为侧边栏添加 SVN 源代码管理面板，支持 status / diff / log / commit / update / revert 等常用操作",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ztyhehe/dsh-better-sidebar-svn"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-better-sidebar",
    "deepseek-harness",
    "svn",
    "sidebar"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "dsh-better-sidebar": "^0.21.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsc -p tsconfig.client.json && node scripts/bundle-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "watch": "node scripts/bundle-client.mjs --watch",
    "preversion": "pnpm typecheck && pnpm test",
    "version": "pnpm build",
    "postversion": "git push --follow-tags"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-rc.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "dsh-better-sidebar": "^0.21.1",
    "esbuild": "^0.28.2",
    "typescript": "~5.8"
  }
}
